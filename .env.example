# --- App A: S2S OAuth (WebSocket subscription) ---
S2S_CLIENT_ID=
S2S_CLIENT_SECRET=
WS_SUBSCRIPTION_ID=
WS_URL=wss://ws.zoom.us/ws

# --- App B: General App (Public Client / PKCE, per-user OAuth) ---
# Public client has NO secret. Register a loopback redirect (RFC 8252);
# the port may be omitted (http://127.0.0.1/callback) — the app injects the
# live PORT at request time.
PUBLIC_CLIENT_ID=
OAUTH_REDIRECT_URI=http://127.0.0.1/callback

# --- Local ---
PORT=3000
DATA_DIR=./data
LOG_LEVEL=debug
